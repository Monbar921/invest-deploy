# Секреты локального стенда: скопируйте в .env и заполните. .env в git не попадает.
# Значения попадают в Secret invest-secrets при каждом деплое.

# Токен T-Invest API
TINKOFF_TOKEN=

# Пароли БД применяются только при первом создании тома Postgres
POSTGRES_PASSWORD=postgres
INVEST_DB_PASSWORD=invest
KEYCLOAK_DB_PASSWORD=keycloak

# Админка Keycloak: пользователь admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Секрет клиента invest-gateway: подставляется в realm при первом импорте и в gateway
KEYCLOAK_CLIENT_SECRET=invest-gateway-dev-secret
