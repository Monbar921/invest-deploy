# Секреты локального стенда: скопируйте в .env и заполните. .env в git не попадает.
# Значения попадают в Secret invest-secrets при каждом деплое.

# Токен T-Invest API
TINKOFF_TOKEN=

# Пароли БД применяются только при первом создании тома Postgres
POSTGRES_PASSWORD=postgres
INVEST_DB_PASSWORD=invest
KEYCLOAK_DB_PASSWORD=keycloak

# Админка Keycloak: пользователь admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Секрет клиента invest-gateway: подставляется в realm при первом импорте и в gateway
KEYCLOAK_CLIENT_SECRET=invest-gateway-dev-secret

# Telegram-бот уведомлений (invest-api): токен от @BotFather, имя бота без @. Пусто / false - бот выключен.
# Telegram заблокирован: поды ходят к нему через sing-box TUN на Windows, прокси в приложении не нужен
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Публичный Telegram-канал (invest-api): бот должен быть администратором канала. Канал - @имя или -100...,
# адрес сайта - для ссылок в постах (на стенде http://invest.localhost:8088). false - в канал ничего не уходит
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_CHAT_ID=
TELEGRAM_CHANNEL_SITE_URL=

# Импорт сделок от брокера (invest-api): ключ шифрования токенов T-Invest пользователей, 32 байта в Base64
# (openssl rand -base64 32). Пусто - импорт по токену выключен, импорт файлов работает. Не меняйте без нужды:
# со сменой ключа сохранённые токены перестают читаться и их подключают заново
IMPORT_TOKEN_KEY=
